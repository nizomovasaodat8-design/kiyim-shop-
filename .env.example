# Bu faylni nusxalab, nomini ".env" qiling va qiymatlarni yozing.
# .env ni hech kimga bermang va GitHub'ga yuklamang!

# Server porti
PORT=3000

# AI kiyib ko'rish uchun Google Gemini kaliti (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Ixtiyoriy: aniq model nomi. Bo'sh qolsa, server o'zi mos rasm-modelni tanlaydi.
GEMINI_MODEL=

# Ixtiyoriy: Hugging Face tokeni — bepul AI limitini oshiradi
# (https://huggingface.co/settings/tokens → New token → Read)
HF_TOKEN=

# Admin sahifa paroli (http://localhost:3000/admin.html)
ADMIN_PASSWORD=

# Ixtiyoriy: yangi buyurtma Telegramga kelishi uchun
# 1) @BotFather da bot yarating → tokenni oling
# 2) Botga /start yozing, keyin https://api.telegram.org/bot<TOKEN>/getUpdates dan chat id ni oling
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
